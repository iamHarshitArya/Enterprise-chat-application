# Enterprise Knowledge Assistant — backend environment
# Copy this file to .env and edit values as needed.

# --- App ---
APP_NAME="Enterprise Knowledge Assistant"
APP_VERSION=2.0.0
ENVIRONMENT=dev
DEMO_AUTH_ENABLED=false
# Public demo access is employee-only; keep disabled outside evaluation deployments.
DEMO_AUTH_PUBLIC=false
HOST=0.0.0.0
PORT=8000
AUTH_DATABASE_PATH="./data/auth/auth.sqlite3"
SESSION_TTL_SECONDS=28800
# Optional initial admin. Use a unique password of at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- CORS (comma-separated origins) ---
CORS_ORIGINS="http://localhost:8000,http://localhost:5500,http://127.0.0.1:8000,http://127.0.0.1:5500"

# --- Vector DB ---
VECTOR_DB_PATH="./data/chroma_db"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIM=384
COLLECTION_PREFIX=eka_

# --- RAG retrieval ---
RETRIEVAL_TOP_K=5
RERANK_TOP_K=3
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- LLM (required for generated knowledge answers) ---
# Google Gemini API free tier.
# Create a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Hugging Face Inference Providers (hosted API; no local model weights).
# Create a user token with Inference Providers permission at https://huggingface.co/settings/tokens
# Select explicitly; Gemini remains the default provider.
# LLM_PROVIDER=huggingface
HF_TOKEN=
HF_MODEL_ID=openai/gpt-oss-20b:fastest
HF_PROVIDER=auto

# Paid alternative: select OpenAI and provide its billing-enabled API key.
# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# --- Agents ---
ENABLED_AGENTS=hr,it,policy

# --- Analytics ---
ENABLE_ANALYTICS=true
